@@ -809,6 +809,91 @@ void shouldNotAddNoteToSummaryCommentThreadIfOtherCommentsInDiscussionAndNoteAlr
         verify(gitlabClient).getMergeRequestDiscussions(PROJECT_ID, MERGE_REQUEST_IID);
